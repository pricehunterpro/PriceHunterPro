# App
APP_NAME=PriceHunter Pro
SECRET_KEY=genera-una-clave-segura-aqui
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/pricehunter
REDIS_URL=redis://redis:6379/0

# Auth
# OBLIGATORIO en produccion: con ENVIRONMENT=production el backend NO arranca si
# este valor falta o sigue siendo el de por defecto (cualquiera podria firmarse
# un token con role=superadmin). Generar con: openssl rand -hex 32
JWT_SECRET_KEY=genera-otra-clave-aqui
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Origenes permitidos por CORS, separados por coma. No puede ser "*" en produccion.
CORS_ORIGINS=https://pricehunter-pro.vercel.app,http://localhost:4200

# Culqi
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=

# Notifications
RESEND_API_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=

# Sentry
SENTRY_DSN=

# Scraping
SCRAPE_INTERVAL_HOURS=1
REQUEST_DELAY_SECONDS=2
MAX_RETRIES=3
